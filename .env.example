# Токен бота от @BotFather
BOT_TOKEN=
# Адрес мини-аппа: тот же сервер по https, или GitHub Pages для демо без сервера
WEBAPP_URL=https://automatorr192-dev.github.io/glyanets/
# Чат администратора студии: сюда приходят записи, переносы, отмены и «позовите человека»
ADMIN_CHAT_ID=
# Предоплата через RollyPay (rollypay.io): ключ и секрет подписи выдаются при создании кассы.
# В настройках кассы укажите callback_url: https://<адрес сервера>/api/payments/rollypay
# Пусто — записи без предоплаты. ROLLYPAY_TEST=1 — тестовые платежи, деньги не списываются
ROLLYPAY_API_KEY=
ROLLYPAY_SIGNING_SECRET=
ROLLYPAY_TEST=1
PREPAY_PERCENT=20
# Сколько машин студия берёт одновременно
BOXES=2
# Пусто — sqlite в /data; для продакшена — Postgres
DATABASE_URL=
# ИИ-администратор в чате
OPENROUTER_API_KEY=
AGENT_MODELS=nvidia/nemotron-3-super-120b-a12b:free,nvidia/nemotron-3-ultra-550b-a55b:free,deepseek/deepseek-v4-flash
# Бот в MAX (dev.max.ru, только самозанятым, ИП и юрлицам). Пусто — MAX выключен
MAX_BOT_TOKEN=
